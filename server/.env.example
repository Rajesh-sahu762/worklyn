# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/worklyn

# JWT (generate strong random secrets; never commit real values)
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_TOKEN=replace_with_a_different_long_random_refresh_secret
OTP_HASH_SECRET=replace_with_another_long_random_secret

# Resend transactional email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Worklyn <onboarding@your-verified-domain.com>"
EMAIL_REPLY_TO=support@your-verified-domain.com
